CLUSTER_NAME=k8s-ha
COMPONENTS=all
KUBE_VERSION=v1.36.4
K8S_DOMAIN=lb.rise.io
ENDPOINT_TYPE=kube-vip
ENDPOINT_ADDRESS=192.168.64.100
ENDPOINT_PORT=6443

REGISTRY_MODE=harbor
HARBOR_DOMAIN=harbor.rise.io
HARBOR_PORT=443
HARBOR_HTTP=false
HARBOR_VIP=

LOCAL_STORAGE=true
LOCAL_PATH=/data/local-pv

NFS_VERSION=4
NFS_ANON_UID=65534
NFS_ANON_GID=65534
NFS_MODE=new
NFS_NODE=k8s-node1
NFS_PATH=/data/nfs

ARTIFACT_FILE=/root/delivery-v4.0.10/artifact/kubekey-artifact.tgz
ARTIFACT_SHA256=
DEPS_MODE=iso

NODES='k8s-node1|192.168.64.4|192.168.64.4|root|22|arm64|ubuntu-22.04-debs|control_plane,worker,registry|ssh|/data|existing||
k8s-node2|192.168.64.5|192.168.64.5|root|22|arm64|ubuntu-22.04-debs|control_plane,worker|ssh|/data|existing||
k8s-node3|192.168.64.6|192.168.64.6|root|22|arm64|ubuntu-22.04-debs|control_plane,worker|ssh|/data|existing||'

KK_VERSION=v4.0.10
WORK_DIR=/data/rise-deploy
PACKAGE_WORK_DIR=/data/kubekey-package
SSH_KEY=/root/.ssh/rise_deploy
SSH_PARALLEL=5
MIN_ROOT_FREE_GIB=5
ALLOW_ROOT_WORKDIR=true

POD_CIDR=10.233.64.0/18
SERVICE_CIDR=10.233.0.0/18
HARBOR_SOURCE_DIR=/var/lib/harbor/data
HARBOR_CA=
HARBOR_CERT=
HARBOR_KEY=

SSH_AUTH_MODE=password
NTP_MODE=node
NTP_NODE=k8s-node1
NTP_ALLOW_LOCAL=true
NTP_MAX_CORRECTION=0.5
