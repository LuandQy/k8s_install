# 三个独立节点 复用外部 Harbor；此示例用于 plan，执行前替换网络、CA和制品路径。
CLUSTER_NAME=external-harbor
COMPONENTS=k8s
IMPORT_IMAGES=false
REGISTRY_MODE=external-harbor
HARBOR_ADDRESS=192.0.2.10
HARBOR_DOMAIN=harbor.example.invalid
HARBOR_PORT=443
HARBOR_HTTP=false
HARBOR_CA=/data/external-cluster/public/harbor-ca.pem
HARBOR_CERT=
HARBOR_KEY=
HARBOR_VIP=
K8S_DOMAIN=api.example.invalid
ENDPOINT_TYPE=local
POD_CIDR=10.234.64.0/18
SERVICE_CIDR=10.234.0.0/18
CLUSTER_VERIFY_MODE=cross-node
KUBE_VERSION=v1.36.4
DEPS_MODE=iso
ARTIFACT_FILE=
ARTIFACT_SHA256=
SSH_AUTH_MODE=key
SSH_KEY=/data/external-cluster/keys/id_ed25519
# 执行前通过可信控制台核对 IP/MAC/公钥后设置；不要使用未经核验的 ssh-keyscan。
# SSH_KNOWN_HOSTS=/data/external-cluster/keys/known_hosts
SSH_PARALLEL=2
WORK_DIR=/data/external-cluster/work
STATE_DIR=/data/external-cluster/state/cluster
MIN_ROOT_FREE_GIB=20
ALLOW_ROOT_WORKDIR=true
LOCAL_STORAGE=true
LOCAL_PATH=/data/local-pv
NTP_MODE=node
NTP_NODE=node1
NTP_ALLOW_LOCAL=true
NTP_SERVERS=
NFS_MODE=none
NODES='node1|192.0.2.101|192.0.2.101|root|22|amd64|ubuntu-24.04-debs|control_plane|ssh|/data|native||
node2|192.0.2.102|192.0.2.102|root|22|amd64|ubuntu-24.04-debs|worker|ssh|/data|native||
node3|192.0.2.103|192.0.2.103|root|22|amd64|ubuntu-24.04-debs|worker|ssh|/data|native||'
