apiVersion: kubekey.kubesphere.io/v1
kind: Inventory
metadata:
  name: default
spec:
  hosts:
    control-01:
      connector:
        type: ssh
        host: 192.0.2.11
        user: root
      internal_ipv4: 192.0.2.11
    worker-01:
      connector:
        type: ssh
        host: 192.0.2.12
        user: root
      internal_ipv4: 192.0.2.12
  groups:
    k8s_cluster:
      groups: [kube_control_plane, kube_worker]
    kube_control_plane:
      hosts: [control-01]
    kube_worker:
      hosts: [worker-01]
    etcd:
      hosts: [control-01]
    image_registry:
      hosts: [control-01]
