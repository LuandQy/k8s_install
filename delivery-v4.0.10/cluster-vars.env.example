# 现场配置模板：复制为 cluster-vars.env，或由 ./deploy.sh 菜单生成。
# 本文件会被 Bash source，只能使用可信来源。修改后建议 chmod 600 cluster-vars.env。
# 一行一个变量；路径不要使用空格、中文、.. 或 shell 表达式。节点清单可使用多行单引号。
# 初始化后不必复制 effective.env：安装入口会自动校验并使用实际磁盘参数。
# 更改本文件后旧初始化索引会失效；先预览/检查，再判断需要重新初始化、扩容还是重建。

# ===== 常用配置：集群、入口、仓库、存储、离线包 =====
# 集群名也决定默认状态目录 state/<集群名>。交付后不要随意更名或删除 state/。
CLUSTER_NAME=rise
# all=整套；harbor=仅仓库；k8s=复用已有仓库安装集群。也可通过 --components 临时指定。
COMPONENTS=all
# 默认在前置阶段为全部 K8s 节点安装 nerdctl 及 /etc/nerdctl/nerdctl.toml（namespace=k8s.io）。
INSTALL_NERDCTL=true
# 版本必须存在于当前 artifact 中；./deploy.sh --versions 可列出支持版本。
KUBE_VERSION=v1.36.4

# API 域名会用于集群入口；不要与 Harbor 域名相同。
K8S_DOMAIN=lb.rise.io
# local：单控制平面；kube-vip：控制平面漂移 VIP；external：现场已有外部负载均衡。
# 三控制平面必须选择 kube-vip 或 external，脚本不会替你搭建外部负载均衡。
ENDPOINT_TYPE=local
# kube-vip / external 必填 IPv4；kube-vip 不能复用节点 IP 或 Harbor VIP。
ENDPOINT_ADDRESS=
ENDPOINT_PORT=6443

# harbor：一个 registry 节点；ha-harbor：至少两个 registry 节点和独立 VIP。
# external-harbor：仅 COMPONENTS=k8s，NODES 禁止 registry/外部仓库主机，要求公开 CA 和 HTTPS。
REGISTRY_MODE=harbor
# 仅 external-harbor 填写 IPv4；详见 docs/multinode-deployment.md。
HARBOR_ADDRESS=
HARBOR_DOMAIN=harbor.rise.io
HARBOR_PORT=443
# 默认 HTTPS；仅在明确接受现场明文传输时设为 true。
HARBOR_HTTP=false
HARBOR_VIP=
# 仅 ha-harbor：keepalived 的 VRRP Router ID（1–255，默认 31）。同一二层网络内必须唯一。
HARBOR_VRRP_ID=31
# 密码没有默认值。向导隐藏输入；静默部署请在进程环境中显式提供 HARBOR_PASSWORD。
# 不要把真实密码写入模板、示例、命令历史或对外交付的配置。

# local PV 使用节点本地磁盘；节点故障不会自动迁移该节点的数据。
LOCAL_STORAGE=true
LOCAL_PATH=/data/local-pv
# none：不用 NFS；new：由清单内节点提供；existing：使用已有外部 NFS。
# new 在 deps 安装服务端依赖；离线包缺少 nfs-kernel-server/nfs-utils 及依赖时停止。
# services-init 配置独立 exports 文件并验收挂载读写；PVC/业务 UID 权限仍需实机验收。
NFS_VERSION=4
NFS_ANON_UID=65534
NFS_ANON_GID=65534
NFS_MODE=new                  # 默认自建；none=不启用；existing=外部服务
NFS_NODE=node1                # new 时填写 NODES 中的节点名；留空自动取第一个控制平面
NFS_SERVER=                   # existing 时填写服务端 IP 或域名
NFS_PATH=/data/nfs            # 服务端实际导出路径

# 离线交付填写内层 kubekey-artifact.tgz 的绝对路径，不是最外层交付包 tar.gz。
# 必须保留相邻 artifact/tools、manifests.yaml 和 SHA256SUMS。
ARTIFACT_FILE=
ARTIFACT_SHA256=              # 对上述内层 tgz 计算的 SHA256；向导自动计算
# iso：从离线 ISO 准备依赖；preinstalled：现场已预装依赖；online：需要软件源联网。
# 交互向导固定生成 iso；在线等高级模式请人工修改，并核对网络条件。
DEPS_MODE=iso

# 每行一个节点，字段顺序固定，使用 | 分隔；推荐由菜单填写，避免手写错位。
# 1 名称 | 2 SSH连接IP | 3 内部IP | 4 SSH用户 | 5 SSH端口 | 6 架构 | 7 系统依赖包
# 8 角色 | 9 连接方式 | 10 数据根目录 | 11 数据策略 | 12 设备 | 13 密码环境变量名
# 角色：control_plane 控制平面、worker 业务、registry 仓库；多角色用英文逗号组合。
# etcd 自动与 control_plane 同机；控制平面只有显式包含 worker 才承载普通业务。
# connection：local 本机（最多一个）或 ssh；普通 SSH 用户须能免密 sudo。
# arch：amd64 / arm64；os：ubuntu-22.04-debs / ubuntu-24.04-debs / kylin-v10SP3-2403-rpms。
# data_mode：auto 初始化时交互选择；existing 已挂载独立数据盘；native 使用原生目录、不建软链接。
# format 仅用于明确指定整盘的高级配置，始终需要人工确认，-y 不能跳过。
# device 通常留空；password_env 仅写变量名（例如 NODE1_PASSWORD），绝不能填写密码值。
# 以下为示例地址，部署前必须替换；本机连接须确保 IP 实际属于控制端。
NODES='node1|192.0.2.10|192.0.2.10|root|22|amd64|ubuntu-24.04-debs|control_plane,worker,etcd,registry|local|/data|auto||'

# ===== 高级配置：通常保留默认值，确需修改时先预览和检查 =====
# 固定工具版本，不能仅修改该变量就切换 KubeKey 二进制。
# 随包为 v4.0.10；摘要表保留 v4.0.9 记录，需要回退时用 ./tools/kk-fetch.sh 重装并核对摘要。
KK_VERSION=v4.0.10
# 部署工作目录存放 KubeKey 工作数据；应在数据盘上，避免占满系统盘。
WORK_DIR=/data/rise-deploy
# 独立制包时的工作目录；交付部署一般无需调整。
PACKAGE_WORK_DIR=/data/kubekey-package
# 初始化生成/复用的 SSH 私钥路径；私钥不会放进对外交付包。
SSH_KEY=/root/.ssh/rise_deploy

# 可选预先通过可信控制台固定的公钥文件；空值保持原 accept-new 行为。
# KK 内部不校验主机公钥，strict 前置核验不能消除其后续连接窗口。
SSH_PARALLEL=5                # 并发上限 1–32，低配控制端应降低
MIN_ROOT_FREE_GIB=20          # native 模式安装前要求的根盘可用空间（GiB）
ALLOW_ROOT_WORKDIR=false      # 独立控制端确需使用根盘时才设为 true

# Pod / Service 网段必须互不重叠，也不能与节点或现场路由冲突。
# 安装完成后更改网段不属于普通参数调整，需按重建流程处理。
POD_CIDR=10.233.64.0/18
SERVICE_CIDR=10.233.0.0/18
# cross-node 需至少两个同架构 K8s 节点；PVC 仍只验收首控制节点，不代表 HA。
CLUSTER_VERIFY_MODE=selected-node
# Harbor 实际源数据路径，必须与仓库配置一致；初始化可能将其链接至数据盘。
HARBOR_SOURCE_DIR=/var/lib/harbor/data
# 受管 Harbor 的服务证书由 KubeKey 生成（SAN 含域名、仓库节点与 VIP）；HARBOR_CERT/HARBOR_KEY
# 当前不参与签发，保持为空。仅 k8s 复用已有仓库时可只填 HARBOR_CA 作为公开信任材料。
HARBOR_CA=
HARBOR_CERT=
HARBOR_KEY=
# 可选：自带根 CA（BYO CA）。两项必须同时填写；安装前由 root 校验自签名/CA:TRUE/有效期/证书与私钥匹配，
# 再复制到 WORK_DIR/pki（私钥 0600）。KubeKey 以 IfNotPresent 复用，影响 K8s、etcd 与 Harbor 全部证书。
# 已有集群不能中途更换根 CA。HARBOR_CERT/HARBOR_KEY 仍不参与签发。
# 逗号分隔的内网时间服务器；NTP_MODE=external 必填，node 可为空但需显式允许本地时间源。
NTP_SERVERS=
# 可选自定义状态目录：必须长期保留。未设置时使用工具目录 state/<CLUSTER_NAME>。
# STATE_DIR=/data/rise-state/rise
# 更多拓扑参考 examples/single-master.env、examples/three-master.env。

# bootstrap: 密码辅助分发公钥；key: 已有密钥；password: 持续密码登录（第13列填写变量名）。
SSH_AUTH_MODE=bootstrap

# existing 保留现场 chrony；external 配置 NTP_SERVERS；node 指定集群节点为服务端。
NTP_MODE=node                # 默认自建；existing=保留现场；external=外部源
NTP_NODE=node1               # 留空自动取第一个控制平面
NTP_ALLOW_LOCAL=true         # 离线自建时明确允许本地时钟
NTP_MAX_CORRECTION=0.5
